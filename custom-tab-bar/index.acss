.tab-bar{
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #E7ECF4;
  padding-bottom: 34rpx;
  box-sizing: border-box;
  box-shadow: 0 -8rpx 24rpx rgba(11,36,71,0.06);
  z-index: 100;
}
.tab-item{
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 4rpx;
}
.tab-item:active{ opacity: 0.7; }
.tab-icon{ width: 56rpx; height: 56rpx; }
.tab-text{
  font-size: 24rpx;
  font-weight: 600;
  color: #9AA7BC;
  margin-top: 8rpx;
}
.tab-text.active{ color: #0B62E6; }
