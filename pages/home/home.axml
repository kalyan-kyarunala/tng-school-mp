
<view class="page pad">
  <!-- push notification preview (simulates a TNGD deeplink notification landing here) -->
  <view class="notif-banner" a:if="{{showPushNotif}}">
    <view class="ico i-coral ico-sm" onTap="openPushNotif"><image class="icon icon-sm" src="{{notif.icon}}"/></view>
    <view class="flex1" style="margin-left:20rpx" onTap="openPushNotif">
      <view class="row between"><text class="notif-app">TNG School</text><text class="tiny faint">now</text></view>
      <view style="font-weight:700;font-size:26rpx;margin-top:4rpx">{{notif.title}}</view>
      <view class="tiny muted" style="margin-top:4rpx;line-height:1.4">{{notif.body}}</view>
    </view>
    <view class="notif-close" catchTap="dismissPushNotif"><image class="icon icon-xs" src="/assets/icons/xmark-blue.png"/></view>
  </view>

  <!-- welcome hero -->
  <view class="hero hero-sm clickable" style="background:linear-gradient(135deg,#4E7FF0,#2E5CC7)" data-url="/pages/children/children" onTap="nav">
    <view class="row between">
      <view class="flex1">
        <text class="tiny" style="opacity:.8;letter-spacing:1.5rpx;text-transform:uppercase;font-weight:700">Welcome back</text>
        <view style="font-size:34rpx;font-weight:800;margin-top:8rpx">Loganathan A/L Suppiah</view>
        <view class="tiny" style="opacity:.85;margin-top:6rpx">Father · 1 child linked</view>
      </view>
      <view style="width:88rpx;height:88rpx;border-radius:24rpx;background:rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:28rpx;color:#fff;flex-shrink:0">LS</view>
    </view>
  </view>

  <!-- child / term selector chips -->
  <view class="chip-row">
    <view class="chip clickable" data-url="/pages/children/children" onTap="nav">
      <image class="icon icon-sm" src="/assets/icons/id-card-blue.png"/>
      <text class="flex1">Kaviya A/P Loganathan</text>
      <image class="icon icon-xs" src="/assets/icons/chevron-down-blue.png"/>
    </view>
    <view class="chip">
      <image class="icon icon-sm" src="/assets/icons/calendar-days-blue.png"/>
      <text>Term 2 · 2026</text>
    </view>
  </view>

  <!-- outstanding fees -->
  <view class="card card-p mt">
    <view class="row between">
      <text class="sec-label" style="margin:0">Outstanding fees</text>
      <view class="ico i-coral ico-sm"><image class="icon icon-sm" src="/assets/icons/file-invoice-dollar-coral.png"/></view>
    </view>
    <view class="money" style="font-size:44rpx;margin-top:12rpx">RM 285.00</view>
    <view class="row tiny" style="color:var(--amber);margin-top:10rpx"><view class="pill-dot" style="margin-right:8rpx"></view><text>Due 19 August · 9 days left</text></view>
    <view class="row gap mt">
      <view class="btn flex1 clickable" style="margin:0" data-url="/pages/fee-detail/fee-detail" onTap="nav">Pay now</view>
      <view class="pill info clickable" style="padding:20rpx 26rpx;font-size:24rpx;font-weight:700" data-url="/pages/fees/fees" onTap="navTab">3 items</view>
    </view>
  </view>

  <!-- quick access tile grid -->
  <view class="sec-label">Quick access</view>
  <view class="tile-grid">
    <view class="tile clickable" data-url="/pages/fees/fees" onTap="navTab">
      <view class="ico i-blue"><image class="icon icon-lg" src="/assets/icons/file-invoice-dollar-blue.png"/></view>
      <text class="tile-label">Fees</text>
    </view>
    <view class="tile clickable" data-url="/pages/events/events" onTap="navTab">
      <view class="ico i-amber"><image class="icon icon-lg" src="/assets/icons/ticket-amber.png"/></view>
      <text class="tile-label">Events</text>
    </view>
    <view class="tile clickable" data-url="/pages/inbox/inbox" onTap="navTab">
      <view class="ico i-green"><image class="icon icon-lg" src="/assets/icons/bell-green.png"/></view>
      <text class="tile-label">Notices</text>
    </view>
    <view class="tile clickable" data-url="/pages/card/card" onTap="navTab">
      <view class="ico i-purple"><image class="icon icon-lg" src="/assets/icons/money-bill-wave-purple.png"/></view>
      <text class="tile-label">Card spend</text>
    </view>
    <view class="tile clickable" data-url="/pages/profile/profile" onTap="nav">
      <view class="ico i-blue"><image class="icon icon-lg" src="/assets/icons/id-card-blue.png"/></view>
      <text class="tile-label">Student ID</text>
    </view>
    <view class="tile clickable" data-url="/pages/history/history" onTap="nav">
      <view class="ico i-navy"><image class="icon icon-lg" src="/assets/icons/receipt-navy.png"/></view>
      <text class="tile-label">History</text>
    </view>
  </view>

  <!-- latest notice -->
  <view class="sec-head"><text class="sec-label">Latest notice</text><view class="sec-link" data-url="/pages/inbox/inbox" onTap="navTab"><text>See all</text><image class="icon icon-xs" src="/assets/icons/chevron-right-blue.png"/></view></view>
  <view class="card card-p clickable row" data-url="/pages/notice/notice" onTap="nav">
    <view class="ico i-green"><image class="icon icon-md" src="/assets/icons/bullhorn-green.png"/></view>
    <view class="flex1" style="margin-left:24rpx">
      <view class="row" style="gap:10rpx"><text style="font-weight:700;font-size:27rpx">Mid-term break: 18–22 Aug</text><text class="pill info" style="font-size:18rpx;padding:4rpx 14rpx">NEW</text></view>
      <view class="tiny muted" style="margin-top:4rpx">School closed. Classes resume 25 Aug.</view>
    </view>
  </view>

  <!-- upcoming event -->
  <view class="sec-head"><text class="sec-label">Upcoming event</text><view class="sec-link" data-url="/pages/events/events" onTap="navTab"><text>See all</text><image class="icon icon-xs" src="/assets/icons/chevron-right-blue.png"/></view></view>
  <view class="card card-p clickable row" data-url="/pages/event-detail/event-detail" onTap="nav">
    <view class="date-badge"><text class="date-badge-month">Aug</text><text class="date-badge-day">30</text></view>
    <view class="flex1" style="margin-left:24rpx">
      <view style="font-weight:700;font-size:27rpx">Annual Sports Day</view>
      <view class="tiny muted" style="margin-top:4rpx">Saturday · 8:00 AM · Field A</view>
    </view>
    <view style="text-align:right">
      <view class="money" style="color:var(--coral);font-size:26rpx">RM 15</view>
      <text class="tiny" style="color:var(--tng);font-weight:700;margin-top:6rpx">Join</text>
    </view>
  </view>

  <view style="height:160rpx"></view>
</view>
<custom-tab-bar selected="{{tabIndex}}"></custom-tab-bar>
