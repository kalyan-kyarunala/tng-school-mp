
<view class="page pad">
  <view class="row between">
    <view class="h2">School notices</view>
    <view class="ico ico-sm i-blue"><image class="icon icon-sm" src="/assets/icons/bell-blue.png"/><view class="dot"></view></view>
  </view>
  <view class="seg"><view class="seg-item on">All</view><view class="seg-item">Unread</view></view>
  <view class="card">
    <view class="list-row clickable" data-url="/pages/notice/notice" onTap="nav"><view class="ico i-coral"><image class="icon icon-md" src="/assets/icons/bullhorn-coral.png"/></view>
      <view class="flex1" style="margin-left:24rpx"><view class="row between"><text style="font-weight:700">Mid-term break: 18–22 Aug</text><text class="pill due">New</text></view><view class="tiny muted">Whole school · 2h ago</view></view></view>
    <view class="list-row clickable" data-url="/pages/notice/notice" onTap="nav"><view class="ico i-blue"><image class="icon icon-md" src="/assets/icons/camera-blue.png"/></view>
      <view class="flex1" style="margin-left:24rpx"><view style="font-weight:700">Std 1 photo day — bring RM 12</view><view class="tiny muted">Std 1 Amanah · Yesterday</view></view></view>
    <view class="list-row clickable" data-url="/pages/notice/notice" onTap="nav"><view class="ico i-amber"><image class="icon icon-md" src="/assets/icons/book-amber.png"/></view>
      <view class="flex1" style="margin-left:24rpx"><view style="font-weight:700">Book fair next week</view><view class="tiny muted">Whole school · 2 days ago</view></view></view>
    <view class="list-row clickable" data-url="/pages/notice/notice" onTap="nav"><view class="ico i-green"><image class="icon icon-md" src="/assets/icons/stethoscope-green.png"/></view>
      <view class="flex1" style="margin-left:24rpx"><view style="font-weight:700">Dental check-up consent form</view><view class="tiny muted">Year 4 · 4 days ago</view></view></view>
  </view>

  <view style="height:160rpx"></view>
</view>
<custom-tab-bar selected="{{tabIndex}}"></custom-tab-bar>
