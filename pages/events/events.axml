
<view class="page pad">
  <view class="h2">School events</view>
  <view class="seg"><view class="seg-item on">Upcoming</view><view class="seg-item">My tickets</view></view>

  <view class="card clickable {{index > 0 ? 'mt' : ''}}" style="overflow:hidden;padding:0"
        a:for="{{events}}" a:for-item="ev" a:key="id"
        data-url="/pages/event-detail/event-detail?id={{ev.id}}" onTap="nav">
    <view class="ev-cover">
      <image class="ev-img" mode="aspectFill" src="{{ev.cover}}"/>
      <view class="ev-tag">{{ev.tag}}</view>
      <view class="ev-price">RM {{ev.price}} / ticket</view>
    </view>
    <view class="card-p">
      <view class="ev-title">{{ev.title}}</view>
      <view class="ev-desc">{{ev.desc}}</view>
      <view class="ev-meta"><image class="icon icon-xs icon-mr" src="/assets/icons/calendar-days-muted.png"/><text>{{ev.when}}</text></view>
      <view class="ev-meta"><image class="icon icon-xs icon-mr" src="/assets/icons/location-dot-muted.png"/><text>{{ev.venue}}</text></view>
      <view class="ev-sales">
        <view class="row between"><text class="ev-sales-label">Ticket sales</text><text class="ev-sales-val">{{ev.sold}} / {{ev.capacity}} sold ({{ev.percent}}%)</text></view>
        <view class="progress-track" style="margin-top:12rpx"><view class="progress-fill {{ev.warm ? 'warm' : ''}}" style="width:{{ev.percent}}%"></view></view>
      </view>
    </view>
  </view>

  <view style="height:160rpx"></view>
</view>
<custom-tab-bar selected="{{tabIndex}}"></custom-tab-bar>
