
<view class="page pad">
  <view class="h2">School events</view>
  <view class="seg"><view class="seg-item on">Upcoming</view><view class="seg-item">My tickets</view></view>

  <view class="card clickable" style="overflow:hidden;padding:0" data-url="/pages/event-detail/event-detail" onTap="nav">
    <view class="event-cover" style="background:linear-gradient(135deg,#FFB454,#F2683B)"><image class="icon icon-2xl" src="/assets/icons/trophy-white.png"/></view>
    <view class="card-p"><view class="row between"><text style="font-weight:700;font-size:30rpx">Annual Sports Day</text><text class="money" style="color:var(--coral)">RM 15</text></view>
      <view class="tiny muted mt-s row"><image class="icon icon-xs icon-mr" src="/assets/icons/calendar-days-muted.png"/><text>Sat, 30 Aug · 8:00 AM · School field</text></view></view>
  </view>

  <view class="card clickable mt" style="overflow:hidden;padding:0" data-url="/pages/event-detail/event-detail" onTap="nav">
    <view class="event-cover" style="background:linear-gradient(135deg,#7C9CFF,#4F46E5)"><image class="icon icon-2xl" src="/assets/icons/masks-theater-white.png"/></view>
    <view class="card-p"><view class="row between"><text style="font-weight:700;font-size:30rpx">Annual Concert 2026</text><text class="money" style="color:var(--coral)">RM 25</text></view>
      <view class="tiny muted mt-s row"><image class="icon icon-xs icon-mr" src="/assets/icons/calendar-days-muted.png"/><text>Fri, 12 Sep · 7:30 PM · Main hall</text></view></view>
  </view>

  <view class="card clickable mt" style="overflow:hidden;padding:0" data-url="/pages/event-detail/event-detail" onTap="nav">
    <view class="event-cover" style="background:linear-gradient(135deg,#5EEAD4,#0D9488)"><image class="icon icon-2xl" src="/assets/icons/book-open-white.png"/></view>
    <view class="card-p"><view class="row between"><text style="font-weight:700;font-size:30rpx">Book Fair (free entry)</text><text class="pill paid">Free</text></view>
      <view class="tiny muted mt-s row"><image class="icon icon-xs icon-mr" src="/assets/icons/calendar-days-muted.png"/><text>18–20 Aug · School library</text></view></view>
  </view>

  <view style="height:160rpx"></view>
</view>
<custom-tab-bar selected="{{tabIndex}}"></custom-tab-bar>
