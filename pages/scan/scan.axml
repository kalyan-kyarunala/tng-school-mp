
<view style="min-height:100vh;display:flex;flex-direction:column;background:linear-gradient(180deg,#3D6FE0,#1B3A8C)">
  <view class="row" style="justify-content:flex-end;padding:24rpx 24rpx 0">
    <view class="torch-btn clickable" onTap="toggleTorch">
      <image class="icon icon-xs" src="/assets/icons/bolt-white.png"/>
      <text>Torch</text>
    </view>
  </view>

  <view style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40rpx" onTap="startScan">
    <view class="scan-frame">
      <view class="scan-corner tl"></view>
      <view class="scan-corner tr"></view>
      <view class="scan-corner bl"></view>
      <view class="scan-corner br"></view>
      <view class="scan-line"></view>
    </view>
    <view class="center" style="margin-top:40rpx;padding:0 24rpx">
      <view style="color:#fff;font-weight:800;font-size:30rpx">Point at the school QR</view>
      <view class="tiny" style="color:rgba(255,255,255,.6);margin-top:10rpx;line-height:1.5">It's printed on the enrolment letter, beside the Student ID.</view>
    </view>
  </view>

  <view class="scan-sheet">
    <view class="grabber"></view>
    <text class="sec-label" style="margin:0 0 20rpx">Can't scan?</text>
    <view class="row gap">
      <view class="scan-option flex1 clickable" onTap="chooseImage">
        <view class="ico i-blue"><image class="icon icon-md" src="/assets/icons/camera-blue.png"/></view>
        <view style="font-weight:700;margin-top:16rpx">Upload image</view>
        <view class="tiny muted" style="margin-top:4rpx">Pick a photo of the QR</view>
      </view>
      <view class="scan-option flex1 clickable" onTap="back">
        <view class="ico i-amber"><image class="icon icon-md" src="/assets/icons/id-card-amber.png"/></view>
        <view style="font-weight:700;margin-top:16rpx">Enter ID</view>
        <view class="tiny muted" style="margin-top:4rpx">Type it manually</view>
      </view>
    </view>
    <view class="row mt" style="background:#EEF4FF;border-radius:20rpx;padding:20rpx">
      <image class="icon icon-xs" src="/assets/icons/lock-blue.png"/>
      <text class="tiny" style="color:var(--tng);margin-left:16rpx;flex:1">Scans stay on your phone. Nothing is uploaded until you confirm.</text>
    </view>
  </view>
</view>
