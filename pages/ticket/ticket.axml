
<view class="page pad">
  <view class="burst" style="width:128rpx;height:128rpx"><view class="check" style="width:76rpx;height:76rpx"><image class="icon icon-lg" src="/assets/icons/check-white.png"/></view></view>
  <view class="h2 center">You're registered!</view>
  <view class="tiny muted center mt-s row" style="justify-content:center"><image class="icon icon-xs icon-mr" src="/assets/icons/location-dot-muted.png"/><text>Show this QR at {{ev.gate}} on event day</text></view>

  <view class="card mt" style="overflow:hidden;padding:0">
    <view class="center" style="background:{{ev.ticketGradient}};padding:32rpx;color:#fff">
      <view style="font-weight:800;font-size:32rpx">{{ev.title}}</view>
      <view class="tiny" style="opacity:.9">{{ev.ticketDate}}</view>
    </view>
    <view style="padding:40rpx" class="center">
      <view class="row" style="justify-content:center"><view class="qr lg"><view class="qr-row" a:for="{{qr}}" a:for-item="row" a:for-index="ri"><view class="qr-cell {{cell ? 'on' : ''}}" a:for="{{row}}" a:for-item="cell" a:for-index="ci"></view></view></view></view>
      <view class="dashed"></view>
      <view class="row between tiny" style="text-align:left"><view><view class="muted">Guardian</view><view style="font-weight:700">Loganathan A/L Suppiah</view></view><view style="text-align:right"><view class="muted">Ticket</view><view style="font-weight:700">{{ev.ticketRef}}</view></view></view>
    </view>
  </view>
  <view class="btn dark" data-msg="Ticket saved to TNG inbox" onTap="toast"><image class="icon icon-sm" src="/assets/icons/envelope-white.png"/><text>Save to TNG inbox</text></view>
</view>
