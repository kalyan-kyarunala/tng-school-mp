
<view class="page pad">
  <view class="row between"><view class="h2">Term 2 bill</view><view class="pill due"><image class="icon icon-xs" src="/assets/icons/calendar-days-red.png"/><text>Due 19 Aug</text></view></view>
  <view class="tiny muted mt-s">Chong Wei Xuan · Std 4 Bijak</view>

  <view class="card mt">
    <view class="list-row between"><view><view style="font-weight:600">Tuition fee</view><view class="tiny muted">Monthly · Aug 2026</view></view><text class="money">RM 180.00</text></view>
    <view class="list-row between"><view><view style="font-weight:600">Transport</view><view class="tiny muted">Zone B · return</view></view><text class="money">RM 80.00</text></view>
    <view class="list-row between"><view><view style="font-weight:600">Activity fee</view><view class="tiny muted">Co-curricular</view></view><text class="money">RM 25.00</text></view>
  </view>

  <view class="card card-p mt row between"><text style="font-weight:700">Total due</text><text class="money" style="font-size:44rpx;color:var(--coral)">RM 285.00</text></view>

  <view class="btn coral" onTap="openPay"><image class="icon icon-sm" src="/assets/icons/wallet-white.png"/><text>Pay RM 285.00</text></view>
  <view class="tiny muted center row" style="justify-content:center"><image class="icon icon-xs icon-mr" src="/assets/icons/shield-halved-muted.png"/><text>Paid securely from your TNG eWallet balance</text></view>

  <!-- pay sheet -->
  <view a:if="{{showPay}}">
    <view class="mask" onTap="closePay"></view>
    <view class="sheet">
      <view class="grabber"></view>
      <view class="h2 center">Confirm payment</view>
      <view class="card card-p mt" style="box-shadow:none;background:#F7F9FC">
        <view class="row between tiny"><text class="muted">Term 2 bill</text><text style="font-weight:700">RM 285.00</text></view>
        <view class="divider"></view>
        <view class="row"><view class="ico i-blue" style="width:64rpx;height:64rpx"><image class="icon icon-sm" src="/assets/icons/wallet-blue.png"/></view>
          <view class="flex1" style="margin-left:20rpx"><view style="font-weight:700;font-size:26rpx">TNG eWallet balance</view><view class="tiny muted">RM 642.50 available</view></view>
          <text class="pill info">Change</text></view>
      </view>
      <view class="row between mt"><text style="font-weight:700">Total</text><text class="money" style="font-size:40rpx">RM 285.00</text></view>
      <view class="btn coral" onTap="payNow"><image class="icon icon-sm" src="/assets/icons/wallet-white.png"/><text>Pay with TNG eWallet</text></view>
      <view class="btn ghost" onTap="closePay"><image class="icon icon-sm" src="/assets/icons/xmark-blue.png"/><text>Cancel</text></view>
    </view>
  </view>
</view>
