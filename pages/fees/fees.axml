
<view class="page pad">
  <view class="hero hero-coral">
    <text class="tiny" style="opacity:.92;font-weight:600">Total outstanding</text>
    <view class="money" style="font-size:68rpx;margin-top:8rpx">RM 285.00</view>
    <view class="tiny row" style="opacity:.9;margin-top:4rpx"><image class="icon icon-xs icon-mr" src="/assets/icons/calendar-days-white.png"/><text>Due 19 August 2026</text></view>
  </view>

  <view class="sec-label">Unpaid bills</view>
  <view class="card clickable list-row" data-url="/pages/fee-detail/fee-detail" onTap="nav">
    <view class="ico i-coral"><image class="icon icon-md" src="/assets/icons/file-invoice-dollar-coral.png"/></view>
    <view class="flex1" style="margin-left:24rpx"><view style="font-weight:700">Term 2 — 2026</view><view class="tiny muted">Tuition · Transport · Activity</view></view>
    <view style="text-align:right"><view class="money">RM 285.00</view><text class="pill due" style="margin-top:8rpx">Due 19 Aug</text></view>
  </view>

  <view class="sec-label">Paid</view>
  <view class="card">
    <view class="list-row clickable" data-url="/pages/receipt/receipt" onTap="nav"><view class="ico i-green"><image class="icon icon-md" src="/assets/icons/receipt-green.png"/></view>
      <view class="flex1" style="margin-left:24rpx"><view style="font-weight:700">Term 1 — 2026</view><view class="tiny muted">Paid 12 Jan · Receipt available</view></view>
      <view style="text-align:right"><view class="money muted">RM 310.00</view><text class="pill paid" style="margin-top:8rpx">Paid</text></view></view>
    <view class="list-row"><view class="ico i-green"><image class="icon icon-md" src="/assets/icons/shirt-green.png"/></view>
      <view class="flex1" style="margin-left:24rpx"><view style="font-weight:700">Uniform &amp; books</view><view class="tiny muted">Paid 08 Jan</view></view>
      <view style="text-align:right"><view class="money muted">RM 175.00</view><text class="pill paid" style="margin-top:8rpx">Paid</text></view></view>
  </view>

  <view style="height:160rpx"></view>
</view>
<custom-tab-bar selected="{{tabIndex}}"></custom-tab-bar>
