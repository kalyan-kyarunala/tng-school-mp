
<view class="page">
  <view class="ed-cover">
    <image class="ed-cover-img" mode="aspectFill" src="{{ev.cover}}"/>
    <view class="ev-tag">{{ev.tag}}</view>
  </view>
  <view class="pad">
    <view class="row between">
      <view class="h2" style="font-size:40rpx;flex:1">{{ev.title}}</view>
      <text class="pill {{ev.warm ? 'amber' : 'soon'}}" style="flex-shrink:0;margin-left:16rpx">{{ev.status}}</text>
    </view>
    <view class="card mt">
      <view class="list-row"><view class="ico i-amber"><image class="icon icon-md" src="/assets/icons/calendar-days-amber.png"/></view><view style="margin-left:24rpx"><view style="font-weight:600;font-size:26rpx">{{ev.dateLong}}</view><view class="tiny muted">{{ev.time}}</view></view></view>
      <view class="list-row"><view class="ico i-blue"><image class="icon icon-md" src="/assets/icons/location-dot-blue.png"/></view><view style="margin-left:24rpx"><view style="font-weight:600;font-size:26rpx">{{ev.venueShort}}</view><view class="tiny muted">{{ev.venueNote}}</view></view></view>
    </view>
    <view class="mt" style="line-height:1.65;color:#33425A">{{ev.desc}}</view>

    <view class="card card-p mt">
      <view class="row between"><text class="ev-sales-label">Ticket sales</text><text class="ev-sales-val">{{ev.sold}} / {{ev.capacity}} sold ({{ev.percent}}%)</text></view>
      <view class="progress-track" style="margin-top:14rpx"><view class="progress-fill {{ev.warm ? 'warm' : ''}}" style="width:{{ev.percent}}%"></view></view>
      <view class="tiny muted mt-s">{{ev.remaining}} tickets still available</view>
    </view>

    <view class="card card-p mt row between"><text style="font-weight:700">Ticket price</text><text class="money" style="font-size:40rpx;color:var(--coral)">RM {{ev.price}}</text></view>
    <view class="btn coral" onTap="register"><image class="icon icon-sm" src="/assets/icons/ticket-white.png"/><text>Register &amp; pay RM {{ev.price}}</text></view>
  </view>
</view>
