
<view class="page pad">
  <view class="h2">My children</view>
  <view class="tiny muted mt-s">Switch between kids — even across different schools.</view>

  <view class="card card-p mt clickable" style="border:3rpx solid var(--tng)" data-url="/pages/home/home" onTap="navTab">
    <view class="row"><view class="avatar a-blue">WX</view>
      <view class="flex1" style="margin-left:24rpx"><view style="font-weight:700">Chong Wei Xuan</view><view class="tiny muted">Std 4 Bijak · SJK(C) Kuen Cheng</view></view>
      <view class="pill info"><image class="icon icon-xs" src="/assets/icons/circle-check-blue.png"/><text>Active</text></view></view>
    <view class="divider"></view>
    <view class="row between tiny"><text class="muted">Outstanding</text><text class="money" style="color:var(--coral)">RM 285.00</text></view>
  </view>

  <view class="card card-p mt clickable" data-url="/pages/home/home" onTap="navTab">
    <view class="row"><view class="avatar a-coral">WT</view>
      <view class="flex1" style="margin-left:24rpx"><view style="font-weight:700">Chong Wei Ting</view><view class="tiny muted">Form 2 Amanah · SMK Damansara</view></view>
      <image class="icon icon-xs" src="/assets/icons/chevron-right-faint.png"/></view>
    <view class="divider"></view>
    <view class="row between tiny"><text class="muted">Outstanding</text><text class="money" style="color:var(--green)">RM 0.00 · Paid</text></view>
  </view>

  <view class="btn ghost" data-url="/pages/link/link" onTap="nav"><image class="icon icon-sm" src="/assets/icons/plus-blue.png"/><text>Link another child</text></view>
</view>
